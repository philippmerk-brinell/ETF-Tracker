# FRED API key — free at https://fredaccount.stlouisfed.org/login/secure/
FRED_API_KEY=your_fred_api_key_here

# --- Notification channels (configure at least one) ---

# Option 1: Telegram Bot (free, recommended)
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your new bot once (any text)
# 3. Visit https://api.telegram.org/bot{TOKEN}/getUpdates -> copy the "id" value
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option 2: CallMeBot — free WhatsApp notifications (no Make.com needed)
# 1. Save +34 644 60 78 85 as a contact in WhatsApp
# 2. Send "I allow callmebot to send me messages" to that number on WhatsApp
# 3. You will receive your API key via WhatsApp
# Phone: international format without + (e.g. 49171xxxxxxx for Germany)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Option 3: Make.com webhook (routes to WhatsApp/email/etc via Make.com scenario)
MAKE_WEBHOOK_URL=

# Optional: override SQLite database path (default: data/signal_state.db)
# DB_PATH=data/signal_state.db
