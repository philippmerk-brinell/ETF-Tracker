# ETF Tracker - Environment Variables
# Copy this file to .env and fill in your values

# Backend port (default: 3001)
PORT=3001

# Database path (default: ./data/etf-tracker.db)
DB_PATH=./data/etf-tracker.db

# Scheduler cron (default: every 15 min, Mon-Fri, 8-22 Uhr UTC)
# Format: minute hour day month weekday
SCHEDULER_CRON=*/15 6-20 * * 1-5

# Node environment
NODE_ENV=development
